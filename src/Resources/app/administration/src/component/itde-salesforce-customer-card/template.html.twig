{% block itde_salesforce_customer_card %}
<sw-card
    class="itde-salesforce-customer-card"
    title="Salesforce Sync"
    :is-loading="isLoading"
>
    {% block itde_salesforce_customer_card_status %}
    <div class="itde-salesforce-customer-card__status-row">

        <div class="itde-salesforce-customer-card__status-item">
            <span class="itde-salesforce-customer-card__label">Status</span>
            <sw-label
                v-if="lastEntry"
                :variant="statusVariant"
                appearance="pill"
            >
                {{ lastEntry.status === 'success' ? '✓ Success' : '✗ Error' }}
            </sw-label>
            <span v-else style="color: #999;">Never synced</span>
        </div>

        <div class="itde-salesforce-customer-card__status-item">
            <span class="itde-salesforce-customer-card__label">Last sync</span>
            <span>{{ lastEntry ? formatDate(lastEntry.syncedAt) : '—' }}</span>
        </div>

        <div class="itde-salesforce-customer-card__status-item">
            <span class="itde-salesforce-customer-card__label">SF Contact ID</span>
            <a
                v-if="sfLink"
                :href="sfLink"
                target="_blank"
                rel="noopener"
                style="font-family: monospace; font-size: 12px;"
            >
                {{ sfContactId }}
            </a>
            <span v-else style="color: #999;">—</span>
        </div>

        <div class="itde-salesforce-customer-card__status-item">
            <sw-button
                size="small"
                :is-loading="isSyncing"
                @click="onSyncNow"
            >
                Push to Salesforce
            </sw-button>
            <sw-button
                size="small"
                variant="ghost"
                :is-loading="isPulling"
                :disabled="!sfContactId"
                style="margin-left: 6px;"
                @click="onPullFromSalesforce"
            >
                Pull from Salesforce
            </sw-button>
        </div>

    </div>
    {% endblock %}

    {% block itde_salesforce_customer_card_error %}
    <sw-alert
        v-if="lastEntry && lastEntry.status === 'error'"
        variant="error"
        style="margin-top: 12px;"
    >
        {{ lastEntry.errorMessage }}
    </sw-alert>
    {% endblock %}

    {% block itde_salesforce_customer_card_log %}
    <template v-if="logEntries.length > 0">
        <h4 style="margin: 16px 0 8px; font-size: 13px; color: #52667a;">Sync History (last 10)</h4>
        <sw-data-grid
            :data-source="logEntries"
            :columns="[
                { property: 'syncedAt',   label: 'Date', width: '175px' },
                { property: 'status',     label: 'Status', width: '90px' },
                { property: 'durationMs', label: 'Duration', width: '90px' },
                { property: 'errorMessage', label: 'Error' },
            ]"
            :show-settings="false"
            :show-selection="false"
            :show-actions="false"
            :compact-mode="true"
        >
            <template #column-syncedAt="{ item }">
                {{ formatDate(item.syncedAt) }}
            </template>

            <template #column-status="{ item }">
                <sw-label
                    :variant="item.status === 'success' ? 'success' : 'critical'"
                    appearance="pill"
                    size="small"
                >
                    {{ item.status }}
                </sw-label>
            </template>

            <template #column-durationMs="{ item }">
                {{ item.durationMs != null ? item.durationMs + ' ms' : '—' }}
            </template>

            <template #column-errorMessage="{ item }">
                <span
                    v-if="item.errorMessage"
                    :title="item.errorMessage"
                    style="font-size: 11px; color: #de294c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; max-width: 320px;"
                >
                    {{ item.errorMessage }}
                </span>
                <span v-else style="color: #999;">—</span>
            </template>
        </sw-data-grid>
    </template>
    {% endblock %}

    {% block itde_salesforce_customer_card_load_error %}
    <sw-alert
        v-if="loadError"
        variant="warning"
        style="margin-top: 8px;"
    >
        {{ loadError }}
    </sw-alert>
    {% endblock %}

</sw-card>
{% endblock %}

